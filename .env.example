# =================================================================
# SpeedFace-V5L Attendance Management System - Production Config
# =================================================================

# Server Network Settings
PORT=8088
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# SpeedFace-V5L Biometric Terminal Defaults
DEVICE_IP=192.168.10.15
DEVICE_PORT=4370
AUTO_SYNC_INTERVAL=60

# Database & Automated Rolling Backup Configuration
DB_PATH=./data/attendance.db
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
MAX_BACKUPS=14

# Production Logging
LOG_DIR=./logs
LOG_LEVEL=info

# API Security & Rate Limiting (Requests per minute per IP)
# Note: SpeedFace ADMS hardware traffic (/iclock/*) is always exempted.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
